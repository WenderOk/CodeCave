<Window x:Class="TrafficSignals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficSignals"
        xmlns:viewmodel="clr-namespace:TrafficSignals.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center">
        <Button Content="Тест" Command="{Binding OpenTestCommand}" FontSize="24"/>
        <Button Content="Выйти" Click="Button_Click" FontSize="24"/>
    </StackPanel>
</Window>
